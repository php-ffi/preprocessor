{
    "name": "ffi/preprocessor",
    "type": "library",
    "description": "PHP C23 preprocessor",
    "license": "MIT",
    "keywords": ["ffi", "parser", "compiler", "c", "headers", "preprocessor"],
    "support": {
        "source": "https://github.com/php-ffi/preprocessor",
        "issues": "https://github.com/php-ffi/preprocessor/issues",
        "docs": "https://github.com/php-ffi/preprocessor/blob/master/README.md"
    },
    "authors": [
        {
            "name": "Nesmeyanov Kirill",
            "email": "nesk@xakep.ru",
            "homepage": "https://nesk.me",
            "role": "maintainer"
        }
    ],
    "require": {
        "php": "^8.1",
        "phplrt/exception": "^4.2",
        "phplrt/position": "^4.2",
        "phplrt/runtime": "^4.2"
    },
    "suggest": {
        "psr/log": "To pass the diagnostics to a PSR-3 logger (^1.1|^2.0|^3.0)"
    },
    "autoload": {
        "psr-4": {
            "FFI\\Preprocessor\\": "src"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpat/phpat": "^0.12",
        "phplrt/compiler": "^4.2",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0|^13.0",
        "psr/log": "^1.1|^2.0|^3.0",
        "symfony/var-dumper": "^6.4|^7.4|^8.0"
    },
    "autoload-dev": {
        "psr-4": {
            "FFI\\Preprocessor\\Tests\\": "tests"
        }
    },
    "scripts-aliases": {
        "test:unit": ["phpunit", "unit"],
        "test:functional": ["functional"],
        "linter:check": ["linter", "stan"],
        "phpcs:fix": ["phpcs", "cs", "psr", "per"],
        "grammar:check": ["grammar"],
        "grammar:build": ["build"]
    },
    "scripts": {
        "grammar:check": [
            "phplrt check resources/grammar.pp3 -v",
            "phplrt check resources/tokens.pp3 -v"
        ],
        "grammar:build": [
            "@php bin/build-expression-parser",
            "@php bin/build-token-lexer"
        ],
        "test": [
            "@test:unit",
            "@test:functional"
        ],
        "test:unit": "phpunit --testsuite unit --testdox",
        "test:functional": "phpunit --testsuite functional --testdox",
        "linter:check": "phpstan analyse --configuration phpstan.neon --memory-limit 256M",
        "linter:baseline": "@linter:check --generate-baseline",
        "phpcs:check": "@phpcs:fix --dry-run",
        "phpcs:fix": "php-cs-fixer fix --config=.php-cs-fixer.php --allow-risky=yes --verbose --diff"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev",
            "dev-master": "1.0.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

#!/usr/bin/env php
<?php

declare(strict_types=1);

namespace FFI\Preprocessor\Bin;

/**
 * Generates the parser from the grammar.
 *
 * The generated parser is committed. Run it (or `composer grammar:build`)
 * after every change of `resources/grammar.pp3` or `resources/grammar/*.pp3`
 * and commit the result along with the grammar.
 */

use Phplrt\Compiler\Compiler;
use Phplrt\Compiler\Generator\ClassModifier;
use Phplrt\Compiler\Generator\TargetPhpVersion;
use Phplrt\Source\FileSource;
use Symfony\Component\Console\Logger\ConsoleLogger;
use Symfony\Component\Console\Output\OutputInterface;
use Symfony\Component\Console\Output\StreamOutput;

require __DIR__ . '/../vendor/autoload.php';

const EXPRESSION_GRAMMAR_PATHNAME = __DIR__ . '/../resources/grammar.pp3';
const EXPRESSION_OUTPUT_PATHNAME = __DIR__ . '/../src/Expression/Parser/CompiledExpressionParser.php';

$compiler = new Compiler();

if (\class_exists(ConsoleLogger::class)) {
    $compiler->setLogger(new ConsoleLogger(
        new StreamOutput(\STDOUT, OutputInterface::VERBOSITY_DEBUG),
    ));
}

$compiler
    ->load(FileSource::createFromPathname(EXPRESSION_GRAMMAR_PATHNAME))
    ->generate()
    // The reducers refer to the nodes relative to this namespace,
    // e.g. Node\Literal\IntLiteral\DecIntLiteral or Node\BinaryExpression\AddExpression
    ->withClassImport('FFI\Preprocessor\Expression\Node')
    // The token the @var tags of the reducers refer to
    ->withClassImport('Phplrt\Contracts\Lexer\TokenInterface')
    // The literal parsers and the exceptions are referred to relative to
    // this namespace, e.g. ExpressionParser\IntParser or Exception\SyntaxErrorException
    ->withNamespaceName('FFI\Preprocessor\Expression\Parser')
    ->withClassName('CompiledExpressionParser')
    // Extended by the hand-written ExpressionParser
    ->withClassModifier(ClassModifier::Abstract)
    // The lowest PHP version the library supports
    ->withTargetPhpVersion(TargetPhpVersion::Php81)
    ->save(EXPRESSION_OUTPUT_PATHNAME);

\fwrite(\STDOUT, \sprintf("Generated into %s\n", \realpath(EXPRESSION_OUTPUT_PATHNAME)));

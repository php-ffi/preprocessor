/**
 * -----------------------------------------------------------------------------
 *  The controlling expression of #if and #elif, see ISO/IEC 9899:2024, 6.10.2.
 * -----------------------------------------------------------------------------
 *
 *  The expression after the macro replacement and after the defined macro
 *  expressions, the has_include, has_embed and has_c_attribute expressions
 *  and the identifiers have been replaced by numbers (6.10.2p13): integer
 *  and character constants, punctuators and parentheses. A number of the
 *  preprocessor (6.4.8) is a single token: an integer constant or a token
 *  of no rule.
 *
 *  A node starts where its rule does ($offset), the binary operators are the
 *  exception, see BinaryExpression.
 */

%pragma root Expression
%pragma lexer.pcre.disable Utf8

/**
 * -----------------------------------------------------------------------------
 *  Fragments
 * -----------------------------------------------------------------------------
 */

/**
 * A universal character name, 6.4.3
 */
%fragment UCN               \\u[0-9A-Fa-f]{4}|\\U[0-9A-Fa-f]{8}

/**
 * Escape sequences, 6.4.4.5, and the escape character of GCC, "\e" and
 * "\E" (U+001B)
 */
%fragment SIMPLE_ESCAPE     ['"?\\abefnrtvE]
%fragment NUMERIC_ESCAPE    [0-7]{1,3}|x[0-9A-Fa-f]++
%fragment ESCAPE            \\(?:(?&SIMPLE_ESCAPE)|(?&NUMERIC_ESCAPE))|(?&UCN)

/**
 * What may not directly follow a number: the rest of a number of the
 * preprocessor (6.4.8), a dot, a quote before a digit or a letter and a sign
 * after "e" or "p". "08" is not two constants and "0xE+1" is not a sum.
 */
%fragment NUMBER_END        (?![A-Za-z0-9_\x80-\xFF.]|'[A-Za-z0-9_\x80-\xFF]|\\[uU]|(?<=[eEpP])[+-])

/**
 * Integer constants, 6.4.4.2
 */
%fragment HEX_INT           0[xX][0-9A-Fa-f](?:'?[0-9A-Fa-f])*+
%fragment BIN_INT           0[bB][01](?:'?[01])*+
%fragment OCT_INT           0(?:'?[0-7])*+
%fragment DEC_INT           [1-9](?:'?[0-9])*+
%fragment INT_SIZE          ll|LL|[lL]|wb|WB
%fragment INT_TYPE_SUFFIX   [uU](?&INT_SIZE)?|(?&INT_SIZE)[uU]?
/**
 * GCC: the suffix of an imaginary constant, 3i or 3j, before or after the
 * suffix of the type
 */
%fragment IMAGINARY_SUFFIX  [iIjJ]
/**
 * MSVC: the suffixes of the sized integer types, 1i64 and 1ui64, alone
 */
%fragment MSVC_INT_SUFFIX   [uU]?[iI](?:8|16|32|64)
%fragment INT_SUFFIX        (?&MSVC_INT_SUFFIX)|(?&INT_TYPE_SUFFIX)(?&IMAGINARY_SUFFIX)?|(?&IMAGINARY_SUFFIX)(?&INT_TYPE_SUFFIX)?

/**
 * -----------------------------------------------------------------------------
 *  Tokens
 * -----------------------------------------------------------------------------
 */

%skip T_WHITESPACE [\x20\t\r\n\f\x0B]++

/**
 * Integer constants, 6.4.4.2: a constant of each base is a token of its own,
 * the base is the class of its node
 */
%token T_HEX_INT_LITERAL (?&HEX_INT)(?&INT_SUFFIX)?(?&NUMBER_END)
%token T_BIN_INT_LITERAL (?&BIN_INT)(?&INT_SUFFIX)?(?&NUMBER_END)
%token T_OCT_INT_LITERAL (?&OCT_INT)(?&INT_SUFFIX)?(?&NUMBER_END)
%token T_DEC_INT_LITERAL (?&DEC_INT)(?&INT_SUFFIX)?(?&NUMBER_END)

/**
 * A number of the preprocessor (6.4.8) that is no integer constant, such as
 * "08", "1.5" or "0x", as a single token of no rule
 */
%token T_PP_NUMBER \.?[0-9](?:[eEpP][+-]|'[A-Za-z0-9_\x80-\xFF]|[A-Za-z0-9_.\x80-\xFF]|(?&UCN))*+

/**
 * Character constants with the encoding prefixes, 6.4.4.5
 */
%token T_CHAR_LITERAL (?:u8|[uUL])?'(?:[^'\\\r\n]|(?&ESCAPE))++'

/**
 * A character constant that is empty, not closed or holds an unknown escape
 * sequence, '', 'a or '\q': a single token of no rule
 */
%token T_INVALID_CHAR_LITERAL (?:u8|[uUL])?'(?:[^'\\\r\n]|\\[^\r\n]?)*+'?

/**
 * Punctuators of no operator of the expression, such as `=` or `++`, a
 * token of their own, so that `++` is not read as two `+`. Declared before
 * the operators they start with.
 */
%token T_INVALID_PUNCTUATOR \+\+|--|->|\.\.\.|<<=|>>=|[*/%+\-&^|]=|=(?!=)|%:%:|%:|<:|:>|<%|%>|::|[\[\]{}.;\#]

/**
 * Punctuators of the operators, 6.4.6. A longer one goes before the ones it
 * starts with.
 */
%token T_LOGICAL_OR \|\|
%token T_LOGICAL_AND &&
%token T_SHL <<
%token T_SHR >>
%token T_LESS_EQUAL <=
%token T_GREATER_EQUAL >=
%token T_EQUAL ==
%token T_NOT_EQUAL !=
%token T_LPAREN \(
%token T_RPAREN \)
%token T_QUESTION \?
%token T_COLON :
%token T_COMMA ,
%token T_PIPE \|
%token T_CARET \^
%token T_AMPERSAND &
%token T_LESS <
%token T_GREATER >
%token T_PLUS \+
%token T_MINUS -
%token T_ASTERISK \*
%token T_SLASH /
%token T_PERCENT %
%token T_TILDE ~
%token T_EXCLAMATION !

/**
 * -----------------------------------------------------------------------------
 *  Rules
 * -----------------------------------------------------------------------------
 */

/**
 * 6.5.18 Comma operator
 */
Expression -> {
    /** @var non-empty-list<Node\ExpressionInterface> $children */
    $result = $children[0];

    for ($i = 1, $count = \count($children); $i < $count; ++$i) {
        $result = new Node\BinaryExpression\CommaExpression($result, $children[$i], $offset);
    }

    return $result;
}
  : ConditionalExpression() (
        ::T_COMMA:: ConditionalExpression()
    )*
  ;

/**
 * 6.5.16 Conditional operator, right-associative: a ? b : c ? d : e is
 * a ? b : (c ? d : e)
 */
ConditionalExpression @error("Syntax error, unexpected {token} in the expression") -> {
    /**
     * @var array{Node\ExpressionInterface}|array{
     *     Node\ExpressionInterface,
     *     Node\ExpressionInterface,
     *     Node\ExpressionInterface
     * } $children
     */
    if (\count($children) === 1) {
        return $children[0];
    }

    return new Node\ConditionalExpression($children[0], $children[1], $children[2], $offset);
}
  : BinaryExpression() ConditionalBranches()?
  ;

/**
 * The expressions after "?" and after ":"
 */
ConditionalBranches
  : ::T_QUESTION:: Expression()
    ::T_COLON:: @error("Syntax error, unexpected {token} in the conditional expression, \":\" expected")
    ConditionalExpression()
  ;

/**
 * 6.5.5 to 6.5.15 Binary operators, all the levels of precedence in one
 * rule: the operands and the operators are read as a flat sequence, and the
 * reducer builds the tree by precedence, every level left-associative:
 * a - b - c is (a - b) - c, a + b * c is a + (b * c).
 *
 * A node starts where its left operand does: the leftmost one at the start
 * of the rule, any other one at its own node. In "a + b * c" the product
 * starts at "b".
 */
BinaryExpression -> {
    /** @var non-empty-list<Node\ExpressionInterface|TokenInterface> $children */
    if (\count($children) === 1) {
        // A single operand, an expression of a higher precedence
        \assert($children[0] instanceof Node\ExpressionInterface);

        return $children[0];
    }

    $precedence = static fn(TokenInterface $operator): int => match ($operator->id) {
        self::T_ASTERISK, self::T_SLASH, self::T_PERCENT => 10,
        self::T_PLUS, self::T_MINUS => 9,
        self::T_SHL, self::T_SHR => 8,
        self::T_LESS, self::T_GREATER, self::T_LESS_EQUAL, self::T_GREATER_EQUAL => 7,
        self::T_EQUAL, self::T_NOT_EQUAL => 6,
        self::T_AMPERSAND => 5,
        self::T_CARET => 4,
        self::T_PIPE => 3,
        self::T_LOGICAL_AND => 2,
        default => 1,
    };

    $build = static fn(
        TokenInterface $operator,
        Node\ExpressionInterface $left,
        Node\ExpressionInterface $right,
        int $start,
    ): Node\ExpressionInterface => match ($operator->id) {
        self::T_ASTERISK => new Node\BinaryExpression\MulExpression($left, $right, $start),
        self::T_SLASH => new Node\BinaryExpression\DivExpression($left, $right, $start),
        self::T_PERCENT => new Node\BinaryExpression\RemExpression($left, $right, $start),
        self::T_PLUS => new Node\BinaryExpression\AddExpression($left, $right, $start),
        self::T_MINUS => new Node\BinaryExpression\SubExpression($left, $right, $start),
        self::T_SHL => new Node\BinaryExpression\ShiftLeftExpression($left, $right, $start),
        self::T_SHR => new Node\BinaryExpression\ShiftRightExpression($left, $right, $start),
        self::T_LESS => new Node\BinaryExpression\LessExpression($left, $right, $start),
        self::T_GREATER => new Node\BinaryExpression\GreaterExpression($left, $right, $start),
        self::T_LESS_EQUAL => new Node\BinaryExpression\LessOrEqualExpression($left, $right, $start),
        self::T_GREATER_EQUAL => new Node\BinaryExpression\GreaterOrEqualExpression($left, $right, $start),
        self::T_EQUAL => new Node\BinaryExpression\EqualExpression($left, $right, $start),
        self::T_NOT_EQUAL => new Node\BinaryExpression\NotEqualExpression($left, $right, $start),
        self::T_AMPERSAND => new Node\BinaryExpression\BitwiseAndExpression($left, $right, $start),
        self::T_CARET => new Node\BinaryExpression\BitwiseXorExpression($left, $right, $start),
        self::T_PIPE => new Node\BinaryExpression\BitwiseOrExpression($left, $right, $start),
        self::T_LOGICAL_AND => new Node\BinaryExpression\LogicalAndExpression($left, $right, $start),
        default => new Node\BinaryExpression\LogicalOrExpression($left, $right, $start),
    };

    // The operands built so far with their starts, and the operators that
    // wait for their right operand, of an ascending precedence. Even
    // children are the operands and odd ones the operators.
    /** @var non-empty-list<Node\ExpressionInterface> $operands */
    $operands = [$children[0]];
    $starts = [$offset];
    /** @var list<TokenInterface> $operators */
    $operators = [];
    $depth = 0;

    // Past the last operand every operator waiting is built, as if the
    // input ended with an operator of the loosest precedence of all
    for ($i = 1, $count = \count($children); ; $i += 2) {
        $current = 0;

        if ($i < $count) {
            \assert($children[$i] instanceof TokenInterface);

            $current = $precedence($children[$i]);
        }

        while ($depth > 0 && $precedence($operators[$depth - 1]) >= $current) {
            --$depth;
            $operands[$depth] = $build($operators[$depth], $operands[$depth], $operands[$depth + 1], $starts[$depth]);
        }

        if ($i >= $count) {
            break;
        }

        \assert($children[$i] instanceof TokenInterface && $children[$i + 1] instanceof Node\ExpressionInterface);

        $operators[$depth] = $children[$i];
        ++$depth;
        $operands[$depth] = $children[$i + 1];
        $starts[$depth] = $children[$i + 1]->offset;
    }

    return $operands[0];
}
  : UnaryExpression() (BinaryOperator() UnaryExpression())*
  ;

BinaryOperator
  : <T_ASTERISK> | <T_SLASH> | <T_PERCENT> | <T_PLUS> | <T_MINUS> | <T_SHL> | <T_SHR>
  | <T_LESS> | <T_GREATER> | <T_LESS_EQUAL> | <T_GREATER_EQUAL> | <T_EQUAL> | <T_NOT_EQUAL>
  | <T_AMPERSAND> | <T_CARET> | <T_PIPE> | <T_LOGICAL_AND> | <T_LOGICAL_OR>
  ;

/**
 * 6.5.4 Unary operators
 */
UnaryExpression @error("Syntax error, unexpected {token} in the expression")
  : PlusExpression()
  | MinusExpression()
  | LogicalNotExpression()
  | BitwiseNotExpression()
  | PrimaryExpression()
  ;

/**
 * +x
 */
PlusExpression -> {
    /** @var array{TokenInterface, Node\ExpressionInterface} $children */
    return new Node\UnaryExpression\PlusExpression($children[1], $offset);
}
  : <T_PLUS> UnaryExpression()
  ;

/**
 * -x
 */
MinusExpression -> {
    /** @var array{TokenInterface, Node\ExpressionInterface} $children */
    return new Node\UnaryExpression\MinusExpression($children[1], $offset);
}
  : <T_MINUS> UnaryExpression()
  ;

/**
 * !x
 */
LogicalNotExpression -> {
    /** @var array{TokenInterface, Node\ExpressionInterface} $children */
    return new Node\UnaryExpression\LogicalNotExpression($children[1], $offset);
}
  : <T_EXCLAMATION> UnaryExpression()
  ;

/**
 * ~x
 */
BitwiseNotExpression -> {
    /** @var array{TokenInterface, Node\ExpressionInterface} $children */
    return new Node\UnaryExpression\BitwiseNotExpression($children[1], $offset);
}
  : <T_TILDE> UnaryExpression()
  ;

/**
 * 6.5.2 Primary expressions: a constant or an expression in parentheses
 */
PrimaryExpression
  : ParenthesizedExpression()
  | DecIntLiteral()
  | HexIntLiteral()
  | OctIntLiteral()
  | BinIntLiteral()
  | CharLiteral()
  ;

/**
 * (x), the node of the expression itself
 */
ParenthesizedExpression -> {
    /** @var array{TokenInterface, Node\ExpressionInterface} $children */
    return $children[1];
}
  : <T_LPAREN> Expression()
    ::T_RPAREN:: @error("Syntax error, unexpected {token} in the parenthesized expression, \")\" expected")
  ;

DecIntLiteral -> {
    /** @var TokenInterface $children */
    // @phpstan-ignore-next-line the lexer never yields an empty token, but the contract types its value as string
    $suffix = ExpressionParser\IntSuffixParser::parse($children->value);
    $digits = \substr($children->value, 0, $suffix->offset - 0);
    $digits = \strtolower(\ltrim(\str_replace("'", '', $digits), '0'));

    if ($digits === '') {
        $digits = '0';
    }

    // @phpstan-ignore-next-line the lexer never yields an empty token, but the contract types its value as string
    return new Node\Literal\IntLiteral\DecIntLiteral($digits, $suffix->type, $suffix->isImaginary, $children->value, $offset);
}
  : <T_DEC_INT_LITERAL>
  ;

HexIntLiteral -> {
    /** @var TokenInterface $children */
    // @phpstan-ignore-next-line the lexer never yields an empty token, but the contract types its value as string
    $suffix = ExpressionParser\IntSuffixParser::parse($children->value);
    $digits = \substr($children->value, 2, $suffix->offset - 2);
    $digits = \strtolower(\ltrim(\str_replace("'", '', $digits), '0'));

    if ($digits === '') {
        $digits = '0';
    }

    // @phpstan-ignore-next-line the lexer never yields an empty token, but the contract types its value as string
    return new Node\Literal\IntLiteral\HexIntLiteral($digits, $suffix->type, $suffix->isImaginary, $children->value, $offset);
}
  : <T_HEX_INT_LITERAL>
  ;

OctIntLiteral -> {
    /** @var TokenInterface $children */
    // @phpstan-ignore-next-line the lexer never yields an empty token, but the contract types its value as string
    $suffix = ExpressionParser\IntSuffixParser::parse($children->value);
    $digits = \substr($children->value, 0, $suffix->offset - 0);
    $digits = \strtolower(\ltrim(\str_replace("'", '', $digits), '0'));

    if ($digits === '') {
        $digits = '0';
    }

    // @phpstan-ignore-next-line the lexer never yields an empty token, but the contract types its value as string
    return new Node\Literal\IntLiteral\OctIntLiteral($digits, $suffix->type, $suffix->isImaginary, $children->value, $offset);
}
  : <T_OCT_INT_LITERAL>
  ;

BinIntLiteral -> {
    /** @var TokenInterface $children */
    // @phpstan-ignore-next-line the lexer never yields an empty token, but the contract types its value as string
    $suffix = ExpressionParser\IntSuffixParser::parse($children->value);
    $digits = \substr($children->value, 2, $suffix->offset - 2);
    $digits = \strtolower(\ltrim(\str_replace("'", '', $digits), '0'));

    if ($digits === '') {
        $digits = '0';
    }

    // @phpstan-ignore-next-line the lexer never yields an empty token, but the contract types its value as string
    return new Node\Literal\IntLiteral\BinIntLiteral($digits, $suffix->type, $suffix->isImaginary, $children->value, $offset);
}
  : <T_BIN_INT_LITERAL>
  ;

CharLiteral -> {
    /** @var TokenInterface $children */
    // @phpstan-ignore-next-line the lexer never yields an empty token, but the contract types its value as string
    $result = ExpressionParser\CharParser::parse($children->value);

    // @phpstan-ignore-next-line the lexer never yields an empty token, but the contract types its value as string
    return new Node\Literal\CharLiteral($result->prefix, $result->value, $children->value, $offset);
}
  : <T_CHAR_LITERAL>
  ;

/**
 * -----------------------------------------------------------------------------
 *  Markup of a C source file for finding its preprocessing directives.
 * -----------------------------------------------------------------------------
 *
 *  Every byte belongs to a token: the text, the candidates for a directive,
 *  the comments and the literals. Whether a candidate starts a directive is
 *  told by the reader, which knows what precedes it on its line.
 *
 *  The line splicing of the translation phase 2 goes before the comments of
 *  the phase 3, so line splices may stand between the bytes of every
 *  sequence of several bytes: "*\<new-line>/" ends a comment.
 */

%pragma lexer.pcre.disable Utf8
%pragma parser.disable Phplrt\Parser\Builder\Compiler\LeftRecursionValidationParserCompilerPass

/**
 * Line splices, a backslash immediately followed by a new-line, none or
 * several of them.
 */
%fragment SPLICES (?:\\(?:\r\n|\n|\r))*+

/**
 * A hexadecimal digit of a universal character name.
 */
%fragment HEX (?&SPLICES)[0-9A-Fa-f]

/**
 * A universal character name, a part of an identifier or a number.
 */
%fragment UCN \\(?&SPLICES)(?:u(?&HEX){4}|U(?&HEX){8})

/**
 * 6.4.3 Identifiers, so that the digits of `u8` or `x1` never start a
 * number.
 */
%fragment IDENTIFIER (?:[A-Za-z_\x80-\xFF]|(?&UCN))(?:(?&SPLICES)(?:[0-9A-Za-z_\x80-\xFF]|(?&UCN)))*+

/**
 * 6.4.8 Preprocessing numbers, the digit separators included: `'` continues
 * a number only before a digit or a nondigit.
 */
%fragment NUMBER (?:\.(?&SPLICES))?[0-9](?:(?&SPLICES)(?:[eEpP](?&SPLICES)[+-]|[0-9A-Za-z_\x80-\xFF.]|(?&UCN)|'(?&SPLICES)[0-9A-Za-z_]))*+

/**
 * A splice or an escape sequence: a backslash and the byte after it, a
 * new-line of two bytes included.
 */
%fragment ESCAPE \\(?:\r\n|[\s\S])

/**
 * A string literal or a character constant, up to its closing quote or up to
 * the new-line in case of it is not closed.
 */
%fragment STRING "(?:[^"\\\r\n]++|(?&ESCAPE))*+"?
%fragment CHAR '(?:[^'\\\r\n]++|(?&ESCAPE))*+'?

/**
 * A block comment, up to the end of the file in case of it is not closed.
 */
%fragment COMMENT /(?&SPLICES)\*(?:[^*]++|\*(?!(?&SPLICES)/))*+(?:\*(?&SPLICES)/|\z)

/**
 * A line comment, continued by the line splices.
 */
%fragment LINE_COMMENT /(?&SPLICES)/(?:[^\r\n\\]++|(?&ESCAPE))*+

/**
 * Source text without comments and literals: everything up to a quote, a
 * comment, `#` or `%:`. The `##` operator and a lone `/` or `%` are text.
 */
%token T_TEXT (?:(?&IDENTIFIER)|(?&NUMBER)|[^"'/\#%A-Za-z0-9_\x80-\xFF.\\]++|[.\\]|/(?!(?&SPLICES)[*/])|\#(?&SPLICES)\#|%(?&SPLICES):(?&SPLICES)%(?&SPLICES):|%(?!(?&SPLICES):))++

/**
 * White space between the tokens of a directive: the blanks, the line
 * splices and the block comments.
 */
%fragment BLANKS (?:[\x20\t\f\x0B]++|\\(?:\r\n|\n|\r)|(?&COMMENT))*+

/**
 * 6.4.8 Header names, read as they are written: no comment, literal or escape
 * sequence inside, the line splices aside. A quoted name ends at the first
 * `"`, as GCC reads it.
 */
%fragment HEADER_NAME <(?:[^>\r\n\\]++|\\(?:\r\n|\n|\r)|\\)*+>?|"(?:[^"\r\n\\]++|\\(?:\r\n|\n|\r)|\\)*+"?

/**
 * The end of a name: no byte of an identifier follows it.
 */
%fragment NAME_END (?!(?&SPLICES)(?:[0-9A-Za-z_\x80-\xFF]|(?&UCN)))

/**
 * Names of the directives and the operators whose operand is a header name.
 */
%fragment INCLUDE i(?&SPLICES)n(?&SPLICES)c(?&SPLICES)l(?&SPLICES)u(?&SPLICES)d(?&SPLICES)e(?:(?&SPLICES)_(?&SPLICES)n(?&SPLICES)e(?&SPLICES)x(?&SPLICES)t)?
%fragment IMPORT i(?&SPLICES)m(?&SPLICES)p(?&SPLICES)o(?&SPLICES)r(?&SPLICES)t
%fragment EMBED e(?&SPLICES)m(?&SPLICES)b(?&SPLICES)e(?&SPLICES)d
%fragment HAS _(?&SPLICES)_(?&SPLICES)h(?&SPLICES)a(?&SPLICES)s(?&SPLICES)_(?&SPLICES)

/**
 * `include`, `include_next`, `import` or `embed` and the header name after it.
 */
%fragment HEADER_DIRECTIVE (?:(?&INCLUDE)|(?&IMPORT)|(?&EMBED))(?&NAME_END)(?&BLANKS)(?&HEADER_NAME)

/**
 * `if` or `elif`, whose expression may hold a header name.
 */
%fragment CONDITION_DIRECTIVE (?:i(?&SPLICES)f|e(?&SPLICES)l(?&SPLICES)i(?&SPLICES)f)(?&NAME_END)

/**
 * `__has_include`, `__has_include_next` or `__has_embed` and the header name
 * in its parentheses.
 */
%fragment HAS_HEADER (?&HAS)(?:(?&INCLUDE)|(?&EMBED))(?&BLANKS)\((?&BLANKS)(?&HEADER_NAME)

/**
 * A token of the rest of the line of a directive.
 */
%fragment DIRECTIVE_PART (?&IDENTIFIER)|(?&NUMBER)|[^\r\n\\"'/A-Za-z0-9_\x80-\xFF.]++|\.|(?&ESCAPE)|(?&COMMENT)|(?&LINE_COMMENT)|(?&STRING)|(?&CHAR)|/

/**
 * `#` or `%:` and the rest of its line, the comments and the literals in it
 * included, the header names where a directive or an operator expects one.
 * The new-line that ends the line is captured.
 */
%token T_DIRECTIVE (?:\#|%(?&SPLICES):)(?&BLANKS)(?:(?&HEADER_DIRECTIVE)|(?&CONDITION_DIRECTIVE)(?:(?&HAS_HEADER)|(?&DIRECTIVE_PART))*+)?(?:(?&DIRECTIVE_PART))*+(\r\n|\n|\r)?

%token T_COMMENT (?&COMMENT)
%token T_LINE_COMMENT (?&LINE_COMMENT)
%token T_STRING (?&STRING)
%token T_CHAR (?&CHAR)

Nothing: Nothing();
